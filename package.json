{
  "name": "ecommerce_shop",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "core:init": "npm run core:costco-kr-sync && npm run core:bank-rates && npm run core:d1-sync && npm run core:self-heal",
    "core:daily": "npm run core:costco-kr-sync && npm run core:bank-rates && npm run core:d1-sync && npm run core:self-heal",
    "core:sync": "node scripts/core/sync.js",
    "core:costco-kr-sync": "node scripts/core/costco-kr-full-sync.js",
    "core:costco-kr-quick": "node scripts/core/costco-kr-full-sync.js --mode=quick",
    "core:tags": "node scripts/sync-tags.js",
    "core:weight": "node scripts/core/fix-weights-ai.js",
    "core:home-weights": "node scripts/sync-home-weights.cjs",
    "core:translate": "node scripts/core/translate.js",
    "core:search-index": "node scripts/build-search-index.cjs",
    "core:report": "node scripts/core/report-count.js",
    "core:bank-rates": "node scripts/core/fetch-bank-rates.js",
    "core:host-images": "node scripts/core/host-images.js",
    "core:home-snapshot": "node scripts/core/build-home-snapshot.js",
    "core:fix-translations": "node scripts/core/fix-missing-translations.js",
    "core:d1-sync": "node scripts/core/d1-sync.js",
    "core:self-heal": "node scripts/core/self-heal.js",
    "core:auto-cart": "node scripts/core/auto-cart.js",
    "marketing:post": "node scripts/marketing/run-marketing.js --type=flash_sale",
    "marketing:reel": "node scripts/marketing/run-marketing.js --type=spotlight_reel --with-video",
    "marketing:daily": "node scripts/marketing/run-marketing.js --type=daily --with-video",
    "mobile:assets": "node scripts/mobile/generate-app-assets.js",
    "mobile:prepare": "node scripts/mobile/prepare-release.js",
    "mobile:publish": "node scripts/mobile/upload-to-stores.js",
    "mobile:sync": "npm run build && npx cap sync",
    "autonomous:run": "npm run core:costco-kr-quick && npm run core:self-heal && npm run core:auto-cart && npm run marketing:daily",
    "build": "node scripts/update-build-info.cjs && vite build",
    "deploy:live": "npm run build && node scripts/core/deploy-firebase-hosting.js",
    "deploy:cloudflare": "npm run build && cd dist && npx wrangler pages deploy . --project-name costco-fe --branch=test",
    "lint": "eslint .",
    "test:pricing": "node src/utils/pricing.test.mjs",
    "test:format": "node src/utils/format.test.mjs",
    "test:async": "node src/utils/async.test.mjs",
    "test:shipments": "node src/utils/shipments.test.mjs",
    "test": "npm run test:pricing && npm run test:format && npm run test:async && npm run test:shipments",
    "refresh-cookie": "node scripts/core/auth-cookie.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.13.2",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.1",
    "dotenv": "^16.4.5",
    "html5-qrcode": "^2.3.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.562.0",
    "playwright": "^1.61.0",
    "puppeteer": "^25.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hot-toast": "^2.6.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^6.30.2",
    "tailwind-merge": "^3.4.0",
    "vite-plugin-pwa": "^1.2.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.4.38",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "vite": "^7.2.4",
    "wrangler": "^4.101.0"
  },
  "description": "This template provides a minimal setup to get React working in Vite with HMR and some ESLint rules.",
  "main": "eslint.config.js",
  "keywords": [],
  "author": "",
  "license": "ISC"
}
