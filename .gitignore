# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
.env

# Local runtime junk that must never be tracked (these were polluting git with
# ~8,500 phantom changes). Untrack once with:
#   git rm -r --cached .venv .browser_data
.venv/
.browser_data/
__pycache__/
*.pyc
.pytest_cache/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.vercel
.env*.local
functions/service-account.json
*.json
!package.json
!jsconfig.json
!tsconfig.json
!functions/package.json
!functions/package-lock.json
# Public assets that MUST ship with the build (esp. for CI deploys, which build
# from committed code). manifest is a static asset; the snapshot/search-index are
# generated by the pipeline and committed so the CDN serves them.
!public/manifest.json
!public/home-snapshot.json
!public/search-index.json

# ── SECURITY: secrets that must never be committed ──────────────────────────
# (These were previously tracked — untracked via `git rm --cached`. The values
#  they held are compromised and must be rotated; see SECURITY_FIXES.md.)
page_access_token.txt
scraper/.env
scraper/state.json
state.json
*.keystore
android/app/release-key.keystore
android/app/keystore.properties
keystore.properties
*.bak
*.pem
service-account*.json
.vercel
