default_platform(:android)

platform :android do
  desc "Build signed Android App Bundle (.aab) and publish to Google Play Store"
  lane :release do
    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: "android/"
    )
    upload_to_play_store(
      track: ENV["PLAY_STORE_TRACK"] || "production",
      release_status: "completed",
      aab: "android/app/build/outputs/bundle/release/app-release.aab",
      metadata_path: "fastlane/metadata/android",
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false
    )
  end
end

platform :ios do
  desc "Build signed iOS IPA and publish to Apple App Store Connect / TestFlight"
  lane :release do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false
    )

    cert(
      api_key: api_key,
      team_id: "LHJMY3S9M5",
      keychain_path: lane_context[SharedValues::KEYCHAIN_PATH]
    )

    sigh(
      api_key: api_key,
      app_identifier: "mn.costco.app",
      team_id: "LHJMY3S9M5",
      force: true
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/App/App.xcodeproj",
      team_id: "LHJMY3S9M5",
      bundle_identifier: "mn.costco.app",
      targets: ["App"],
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::SIGH_NAME]
    )

    increment_build_number(
      build_number: ENV["GITHUB_RUN_NUMBER"] || Time.now.strftime("%Y%m%d%H"),
      xcodeproj: "ios/App/App.xcodeproj"
    )

    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        teamID: "LHJMY3S9M5",
        provisioningProfiles: {
          "mn.costco.app" => lane_context[SharedValues::SIGH_NAME]
        }
      },
      output_directory: "output/ios",
      output_name: "CostcoMN.ipa"
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: "mn.costco.app",
      ipa: "output/ios/CostcoMN.ipa",
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end
end
