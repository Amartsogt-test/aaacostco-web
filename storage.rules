rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Banners - public read, admin write
    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.isAdmin == true;
    }
    // Menu images - public read, admin write
    match /menu-images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.isAdmin == true;
    }
    // Chat attachments - authenticated users can upload.
    // SECURITY: restrict to images/PDFs only (previously any file type up to 10MB
    // could be uploaded, e.g. executables/HTML used for malware hosting or stored
    // XSS). Allow delete only for admins.
    match /chat-attachments/{allPaths=**} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024 // 10MB limit
                   && request.resource.contentType.matches('(image/.*|application/pdf)');
      allow delete: if request.auth != null && request.auth.token.isAdmin == true;
    }
    // Default - authenticated read, no public write
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.isAdmin == true;
    }
  }
}
